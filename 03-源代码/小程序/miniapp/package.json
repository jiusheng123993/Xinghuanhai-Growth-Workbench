{
  "name": "xinghechongji-miniapp",
  "private": true,
  "version": "0.1.0",
  "description": "星河宠记微信小程序 - AI主动外联引擎",
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "dev:h5": "taro build --type h5 --watch",
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "build:alipay": "taro build --type alipay",
    "cap:sync": "npm run build:h5 && cap sync android",
    "cap:open": "cap open android",
    "cap:copy": "cap copy android",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "lint:ci": "eslint src --ext .ts,.tsx --max-warnings 260",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@tarojs/components": "^3.6.0",
    "@tarojs/plugin-framework-react": "^3.6.0",
    "@tarojs/react": "^3.6.0",
    "@tarojs/runtime": "^3.6.0",
    "@tarojs/taro": "^3.6.0",
    "crypto-js": "^4.2.0",
    "preact": "^10.29.8",
    "process": "^0.11.10",
    "react": "^18.0.0",
    "zustand": "^3.7.2"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "^3.6.40",
    "@tarojs/plugin-platform-h5": "^3.6.40",
    "@tarojs/plugin-platform-weapp": "^3.6.40",
    "@tarojs/webpack5-prebundle": "^3.6.40",
    "@tarojs/webpack5-runner": "^3.6.40",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-preset-taro": "^4.2.0",
    "eslint": "^8.57.0",
    "eslint-config-taro": "^4.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^29.1.1",
    "react-dom": "^18.0.0",
    "sass": "^1.101.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10",
    "webpack": "5.78.0"
  }
}
