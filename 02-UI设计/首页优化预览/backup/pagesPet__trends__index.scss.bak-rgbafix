@import '../../styles/_theme';

.pet-trends-page {
  min-height: 100vh;
  /* 背景统一由 <PageBackground /> 组件渲染（含星空/格纹/照片壁纸），此处保持透明 */
  background: transparent;
  padding-bottom: 160rpx;
  position: relative;
  // 注意：容器不设 z-index，避免把 fixed 的 .xhh-bg-layer 光斑背景层盖住
  // （与 mine-page / chat-home-page 保持一致，blob 才能正常显示并跟随主题）
}

.pet-trends__time-range {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
}

.pet-trends__time-btn {
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  @include card-base;
  transition: all $transition-normal;
  @include press-feedback;

  &--active {
    background: rgba($color-primary, 0.08);
    border-color: $color-primary;

    .pet-trends__time-btn-text {
      color: $color-primary;
      font-weight: $font-weight-semibold;
    }
  }

  &--locked {
    opacity: 0.6;
  }
}

.pet-trends__time-btn-text {
  font-size: $font-size-sm;
  color: $color-text-secondary;
}

.pet-trends__time-btn-lock {
  font-size: 20rpx;
  margin-left: 4rpx;
}

.pet-trends__tabs {
  display: flex;
  margin: 0 32rpx;
  @include card-base;
  padding: 8rpx;
}

.pet-trends__tab {
  flex: 1;
  @include flex-center;
  padding: 16rpx 0;
  border-radius: 28rpx;
  transition: all $transition-normal;

  &--active {
    background: rgba($color-primary, 0.08);

    .pet-trends__tab-text {
      color: $color-primary;
      font-weight: $font-weight-semibold;
    }
  }
}

.pet-trends__tab-text {
  font-size: $font-size-md;
  color: $color-text-tertiary;
}

.pet-trends__content {
  position: relative;
  z-index: 2;
  flex: 1;
  // 注意：webview 渲染模式不支持 scroll-view 的 padding，内边距放在内部容器上
}

.pet-trends__content-inner {
  padding: 20rpx 32rpx;
}

.pet-trends__chart-area {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

// ==================== AI 月度小结卡 ====================
.trends-ai-card {
  background: $color-primary-bg;
  border-radius: 56rpx;
  padding: 40rpx;
  animation: fadeInUp 0.35s ease-out;
}

.trends-ai-card__head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.trends-ai-card__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, $color-primary-light, $color-primary);
  @include flex-center;
  flex-shrink: 0;
  box-shadow: $shadow-button;
}

.trends-ai-card__icon-text {
  font-size: 32rpx;
  line-height: 1;
}

.trends-ai-card__title {
  flex: 1;
  min-width: 0;
  font-size: $font-size-lg;
  font-weight: $font-weight-bold;
  color: $color-text-primary;
  @include text-ellipsis;
}

.trends-ai-card__badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: $color-bg-card;
  box-shadow: $shadow-xs;

  &--warn {
    background: rgba($color-warning, 0.12);
  }
}

.trends-ai-card__badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: $color-success;

  &--warn {
    background: $color-warning;
  }
}

.trends-ai-card__badge-text {
  font-size: 22rpx;
  font-weight: $font-weight-semibold;
  color: $color-success;

  .trends-ai-card__badge--warn & {
    color: $color-warning;
  }
}

.trends-ai-card__text {
  display: block;
  margin-top: 24rpx;
  font-size: $font-size-sm;
  color: $color-text-secondary;
  line-height: 1.7;
}

// ==================== 图表卡 ====================
.trends-chart-card {
  @include card-base;
  padding: 32rpx;
  animation: fadeInUp 0.35s ease-out;
}

.trends-chart-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.trends-chart-card__title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.trends-chart-card__icon {
  font-size: 32rpx;
  line-height: 1;
  flex-shrink: 0;
}

.trends-chart-card__title {
  font-size: $font-size-lg;
  font-weight: $font-weight-bold;
  color: $color-text-primary;
  @include text-ellipsis;
}

.trends-chart-card__metric {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;

  &--down {
    .trends-chart-card__metric-text {
      color: $color-danger;
    }
  }
}

.trends-chart-card__metric-icon {
  font-size: 24rpx;
  line-height: 1;
}

.trends-chart-card__metric-text {
  font-size: 22rpx;
  font-weight: $font-weight-semibold;
  color: $color-success;
}

// ==================== 异常标记说明 ====================
.trends-note {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 8rpx;
}

.trends-note__icon {
  font-size: 28rpx;
  line-height: 1;
  flex-shrink: 0;
}

.trends-note__text {
  font-size: 22rpx;
  color: $color-text-tertiary;
}

// ==================== 图表内部容器（置于图表卡内，不再自带卡片样式） ====================
.trend-chart__container {
  padding: 0;
  background: transparent;
  box-shadow: none;
}

.trend-chart__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.trend-card {
  @include card-base;
  padding: 32rpx;
  animation: cardStaggerIn 0.4s ease-out both;
}

.trend-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.trend-card__title {
  font-size: $font-size-lg;
  font-weight: $font-weight-semibold;
  color: $color-text-primary;
}

.trend-card__period {
  font-size: $font-size-xs;
  color: $color-text-tertiary;
}

.trend-card__badge {
  font-size: $font-size-xs;
  color: #FFFFFF;
  background-color: $color-danger;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.trend-chart__breed-range-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(140, 173, 126, 0.08);
  border-radius: 16rpx;
  border: 2rpx solid rgba(140, 173, 126, 0.2);
}

.trend-chart__breed-range-label {
  font-size: $font-size-xs;
  color: $color-success;
  font-weight: $font-weight-medium;
}

.trend-chart__breed-range-value {
  font-size: $font-size-xs;
  color: $color-success;
  font-weight: $font-weight-semibold;

  &--warning {
    color: $color-danger;
  }
}

.trend-chart__breed-range-warning {
  font-size: 22rpx;
  color: $color-danger;
  font-weight: $font-weight-semibold;
  margin-left: auto;
  padding: 4rpx 16rpx;
  background: $color-danger-bg;
  border-radius: 12rpx;
  border: 1rpx solid rgba(224, 133, 107, 0.3);
}

/* 品种体重分析卡片 */
.trend-chart__breed-analysis {
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid;

  &--normal {
    background: rgba(140, 173, 126, 0.08);
    border-color: rgba(140, 173, 126, 0.2);
  }

  &--underweight {
    background: rgba($color-primary, 0.06);
    border-color: rgba($color-primary, 0.2);
  }

  &--overweight {
    background: rgba($color-primary, 0.08);
    border-color: rgba($color-primary, 0.25);
  }

  &--obese {
    background: $color-danger-bg;
    border-color: rgba(224, 133, 107, 0.3);
  }
}

.trend-chart__breed-analysis-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.trend-chart__breed-analysis-title {
  font-size: $font-size-md;
  font-weight: $font-weight-semibold;
  color: $color-text-primary;
}

.trend-chart__breed-analysis-value {
  font-size: $font-size-xs;
  color: $color-text-secondary;
  font-weight: $font-weight-medium;
}

.trend-chart__breed-analysis-suggestion {
  display: block;
  font-size: $font-size-sm;
  color: $color-text-secondary;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.trend-chart__breed-trend {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid $color-divider;
}

.trend-chart__breed-trend-label {
  font-size: $font-size-xs;
  color: $color-text-tertiary;
}

.trend-chart__breed-trend-value {
  font-size: $font-size-xs;
  font-weight: $font-weight-semibold;

  &--stable {
    color: $color-success;
  }

  &--increasing {
    color: $color-primary;
  }

  &--decreasing {
    color: $color-danger;
  }
}

.trend-chart__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.trend-chart__empty-text {
  font-size: 30rpx;
  color: $color-text-tertiary;
  margin-bottom: 12rpx;
}

.trend-chart__empty-hint {
  font-size: $font-size-xs;
  color: $color-text-tertiary;
}

.trend-chart__y-axis {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 80rpx;
  padding-right: 16rpx;
  flex-shrink: 0;
}

.trend-chart__y-label {
  font-size: 22rpx;
  color: $color-text-tertiary;
  text-align: right;
}

.trend-chart__plot-area {
  flex: 1;
  position: relative;
}

.trend-chart__grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  pointer-events: none;
}

.trend-chart__grid-line {
  height: 1rpx;
  background-color: $color-primary-bg;
}

.trend-chart__line-chart {
  position: relative;
  width: 100%;
}

.trend-chart__breed-range-zone {
  position: absolute;
  left: 0;
  right: 0;
  background-color: rgba(140, 173, 126, 0.08);
  pointer-events: none;
  z-index: 0;
}

.trend-chart__breed-range-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background-color: rgba(140, 173, 126, 0.4);

  &--top {
    top: 0;
  }

  &--bottom {
    bottom: 0;
  }
}

.trend-chart__svg-line {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.trend-chart__data-point {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
}

.trend-chart__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: $color-primary;
  border: 3rpx solid $color-bg-card;
  box-shadow: 0 2rpx 6rpx rgba($color-primary, 0.4);

  &--abnormal {
    background-color: $color-danger;
    border-color: rgba(224, 133, 107, 0.2);
    box-shadow: 0 2rpx 8rpx rgba(224, 133, 107, 0.5);
  }

  &--out-of-range {
    background-color: $color-danger;
    border-color: rgba(224, 133, 107, 0.2);
    box-shadow: 0 2rpx 8rpx rgba(224, 133, 107, 0.5);
  }
}

.trend-chart__data-point--abnormal {
  .trend-chart__point-value {
    color: $color-danger;
  }
}

.trend-chart__point-value {
  font-size: 20rpx;
  color: $color-primary;
  margin-top: 4rpx;
  white-space: nowrap;

  &--out-of-range {
    color: $color-danger;
  }
}

.trend-chart__x-axis {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  overflow: hidden;
}

.trend-chart__x-label {
  font-size: 20rpx;
  color: $color-text-tertiary;
  text-align: center;
  flex-shrink: 0;
}

// ==================== 健康概览摘要 ====================
.trend-glance {
  @include card-base;
  padding: 28rpx 32rpx;
  animation: fadeInUp 0.3s ease-out;
}

.trend-glance__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.trend-glance__title {
  font-size: $font-size-md;
  font-weight: $font-weight-semibold;
  color: $color-text-primary;
}

.trend-glance__score {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.trend-glance__score-value {
  font-size: 40rpx;
  font-weight: $font-weight-bold;
}

.trend-glance__score-label {
  font-size: 22rpx;
  color: $color-text-tertiary;
}

.trend-glance__score--good { color: $color-success; }
.trend-glance__score--fair { color: $color-primary; }
.trend-glance__score--poor { color: $color-danger; }

.trend-glance__rows {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.trend-glance__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.trend-glance__row-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.trend-glance__row-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.trend-glance__row-label {
  font-size: 22rpx;
  color: $color-text-tertiary;
}

.trend-glance__row-value {
  font-size: $font-size-sm;
  font-weight: $font-weight-medium;
  color: $color-text-primary;
}

.trend-glance__row-value--good { color: $color-success; }
.trend-glance__row-value--warn { color: $color-primary; }
.trend-glance__row-value--bad { color: $color-danger; }

// ==================== 柱状图入场动效 ====================
@keyframes barGrow {
  0% { height: 0; }
}

.trend-chart__bar-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 280rpx;
  padding-bottom: 8rpx;
  overflow-x: auto;
  animation: fadeInUp 0.4s ease-out;
}

.trend-chart__bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 60rpx;
  flex-shrink: 0;

  &--abnormal {
    .trend-chart__bar-wrap {
      border: 2rpx solid $color-danger;
    }
  }
}

.trend-chart__bar-mark {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid $color-danger;
}

.trend-chart__bar-wrap {
  position: relative;
  width: 40rpx;
  height: 200rpx;
  border-radius: 8rpx 8rpx 0 0;
  background-color: $color-primary-bg;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}

.trend-chart__bar {
  width: 100%;
  border-radius: 8rpx 8rpx 0 0;
  transition: height $transition-normal;
  animation: barGrow 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.trend-chart__bar-label {
  font-size: 20rpx;
  color: $color-text-secondary;
  margin-top: 8rpx;
  white-space: nowrap;
}

.trend-chart__legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid $color-divider;
}

.trend-chart__legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.trend-chart__legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.trend-chart__legend-text {
  font-size: 22rpx;
  color: $color-text-secondary;
}

.trend-summary {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.trend-summary__stats {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
  border-bottom: 1rpx solid $color-divider;
  margin-bottom: 24rpx;
}

.trend-summary__stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.trend-summary__stat-value {
  font-size: 40rpx;
  font-weight: $font-weight-bold;
  color: $color-text-primary;
}

.trend-summary__stat-label {
  font-size: 22rpx;
  color: $color-text-tertiary;
}

.trend-summary__ai-text {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.trend-summary__ai-label {
  font-size: $font-size-sm;
  font-weight: $font-weight-semibold;
  color: $color-primary;
}

.trend-summary__ai-content {
  font-size: $font-size-md;
  color: $color-text-secondary;
  line-height: 1.6;
}

.trend-summary__abnormal-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.trend-summary__abnormal-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  background: rgba($color-primary, 0.06);
  border-radius: 16rpx;
}

.trend-summary__abnormal-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.trend-summary__abnormal-date {
  font-size: $font-size-xs;
  color: $color-text-secondary;
  flex-shrink: 0;
}

.trend-summary__abnormal-desc {
  font-size: $font-size-xs;
  color: $color-text-primary;
}

.trend-summary__section {
  margin-bottom: 20rpx;

  &:last-child {
    margin-bottom: 0;
  }
}

.trend-summary__section-title {
  font-size: $font-size-md;
  font-weight: $font-weight-semibold;
  color: $color-text-primary;
  margin-bottom: 12rpx;
}

.trend-summary__list-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 8rpx 0;
}

.trend-summary__list-dot {
  font-size: $font-size-xs;
  line-height: 1.6;
  flex-shrink: 0;
}

.trend-summary__list-text {
  font-size: $font-size-sm;
  color: $color-text-secondary;
  line-height: 1.6;
}

.export-section {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx;
  margin-top: 24rpx;

  // 统一按钮规格：3+2 布局（第一行 3 个、第二行 2 个），每行内等宽、行间对齐，
  // 避免此前 2+2+1 时"分享趋势"单独成行、宽度与其他按钮不一致的失衡观感。
  // 尺寸对齐项目惯例（mine 页按钮 88rpx 高/28rpx 字号），此前 44px/15px 偏小。
  .preview-btn,
  .export-btn,
  .csv-btn,
  .vet-btn,
  .share-btn {
    height: 88rpx;
    line-height: 88rpx;
    border-radius: 44rpx;
    font-size: 28rpx;
    font-weight: $font-weight-medium;
    text-align: center;
    border: none;
    @include press-feedback;
  }

  // 第一行 3 个：各占 (100% - 2×gap) / 3
  .preview-btn,
  .export-btn,
  .csv-btn {
    flex: 1 1 calc((100% - 32rpx) / 3);
    min-width: calc((100% - 32rpx) / 3);
  }

  // 第二行 2 个：各占 (100% - gap) / 2
  .vet-btn,
  .share-btn {
    flex: 1 1 calc((100% - 16rpx) / 2);
    min-width: calc((100% - 16rpx) / 2);
  }

  // 全部跟随主题变量（themeClass 切换时自动换色），避免硬编码五色杂乱

  .preview-btn {
    background: $color-primary-bg;
    color: $color-primary;
    border: 1px solid rgba($color-primary, 0.18);
  }

  .export-btn {
    background: $gradient-gold;
    color: #FFFFFF;
    box-shadow: $glow-sm;
  }

  .csv-btn {
    background: $color-bg-card;
    color: $color-sage;
    border: 1px solid rgba($color-sage, 0.35);
  }

  .vet-btn {
    background: $color-primary-bg;
    color: $color-primary-dark;
    border: 1px solid rgba($color-primary, 0.18);
  }

  .share-btn {
    background: $gradient-warm;
    color: #FFFFFF;
    box-shadow: $glow-md;
  }
}

.report-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;

  .modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: $color-bg-overlay;
  }

  .modal-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 90%;
    max-height: 80%;
    @include card-base;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: fadeInScale 0.3s ease-out;

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px;
      border-bottom: 1px solid $color-border;

      .modal-title {
        font-size: 17px;
        font-weight: $font-weight-semibold;
        color: $color-text-primary;
      }

      .modal-close {
        font-size: 20px;
        color: $color-text-tertiary;
        padding: 4px;
      }
    }

    .modal-body {
      flex: 1;
      overflow-y: auto;
      padding: 0;
    }

    .modal-footer {
      padding: 16px;
      border-top: 1px solid $color-border;

      .download-btn {
        width: 100%;
        height: 44px;
        line-height: 44px;
        background: linear-gradient(135deg, $color-primary, $color-primary-dark);
        color: #FFFFFF;
        border-radius: 22px;
        font-size: 15px;
        font-weight: $font-weight-medium;
        text-align: center;
        border: none;
        @include press-feedback;
      }
    }
  }
}

.pet-trends__disclaimer {
  padding: 20rpx;
  background: rgba($color-primary, 0.06);
  border: 1px solid rgba($color-primary, 0.12);
  border-radius: 16rpx;
  margin: 24rpx 24rpx 0;
}

.pet-trends__disclaimer-text {
  font-size: 22rpx;
  color: $color-primary-light;
  line-height: 1.5;
}