@import '../../styles/_theme';
@import '../../styles/_animations';

// ============================================
// 健康报告页 · 原型 1:1
// ============================================
.health-report {
  min-height: 100vh;
  /* 背景由 <PageBackground /> 组件统一渲染，此处保持透明 */
  background: transparent;
  padding: $spacing-xl $spacing-lg $spacing-xxl;
  display: flex;
  flex-direction: column;
  gap: $spacing-lg;
  animation: pageEnter 0.4s ease-out;
}

.xhh-card {
  background: $color-bg-card;
  border: 1px solid $color-border;
  border-radius: $radius-md;
  box-shadow: $shadow-card;
}

// —— 通用卡片 ——
.hr-card {
  padding: $spacing-lg;

  &__head {
    display: flex;
    align-items: center;
    gap: $spacing-md;
  }

  &__avatar {
    width: 96rpx;
    height: 96rpx;
    border-radius: $radius-full;
    background: $color-primary-bg;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  &__avatar-img {
    width: 100%;
    height: 100%;
    display: block;
  }

  &__avatar-emoji {
    font-size: 48rpx;
  }

  &__titles {
    flex: 1;
    min-width: 0;
  }

  &__name {
    display: block;
    font-size: $font-size-lg;
    font-weight: $font-weight-bold;
    color: $color-text-primary;
  }

  &__meta {
    display: block;
    margin-top: 4rpx;
    font-size: $font-size-xs;
    color: $color-text-tertiary;
  }

  &__pill {
    padding: 6rpx $spacing-md;
    border-radius: $radius-round;
    flex-shrink: 0;

    &--coral {
      background: $color-primary-bg;
    }

    &--success {
      background: rgba($color-success, 0.14);
    }

    &--warn {
      background: rgba($color-gold, 0.16);
    }
  }

  &__pill-text {
    font-size: $font-size-xs;
    font-weight: $font-weight-semibold;

    .hr-card__pill--coral & { color: $color-primary; }
    .hr-card__pill--success & { color: $color-success; }
    .hr-card__pill--warn & { color: $color-gold-deep; }
  }

  &__rows {
    margin-top: $spacing-md;
    display: flex;
    flex-direction: column;
    gap: $spacing-sm;
  }

  &__row {
    display: flex;
    align-items: center;
    gap: $spacing-sm;
  }

  &__row-icon {
    font-size: $font-size-sm;
  }

  &__row-text {
    font-size: $font-size-xs;
    color: $color-text-tertiary;
  }

  &__row-bold {
    font-weight: $font-weight-semibold;
    color: $color-text-secondary;
  }

  // 区块头
  &__section-head {
    display: flex;
    align-items: center;
    gap: $spacing-md;
  }

  &__ico {
    width: 72rpx;
    height: 72rpx;
    border-radius: $radius-full;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32rpx;
    flex-shrink: 0;

    &--coral { background: rgba($color-primary, 0.14); }
    &--gold { background: rgba($color-gold, 0.16); }
    &--warn { background: rgba($color-gold, 0.16); }
  }

  &__section-titles {
    flex: 1;
    min-width: 0;
  }

  &__section-title {
    display: block;
    font-size: $font-size-md;
    font-weight: $font-weight-semibold;
    color: $color-text-primary;
  }

  &__section-sub {
    display: block;
    margin-top: 2rpx;
    font-size: $font-size-xs;
    color: $color-text-tertiary;
  }
}

// —— 健康总览 ——
.hr-overview {
  display: flex;
  align-items: center;
  gap: $spacing-lg;
  margin-top: $spacing-lg;
}

.hr-score {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: $spacing-sm;
  flex-shrink: 0;
}

.hr-score__ring {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  border-radius: $radius-full;
  display: flex;
  align-items: center;
  justify-content: center;
  background-image: linear-gradient(135deg, $color-primary-light, $color-primary);

  &--good {
    background-image: linear-gradient(135deg, $color-success, #7FE0B8);
  }

  &--warn {
    background-image: linear-gradient(135deg, $color-gold-soft, $color-gold-deep);
  }

  &--bad {
    background-image: linear-gradient(135deg, #FF8A8E, $color-danger);
  }

  &::before {
    content: '';
    position: absolute;
    inset: 14rpx;
    border-radius: $radius-full;
    background: $color-bg-card;
  }
}

.hr-score__num {
  position: relative;
  font-size: 52rpx;
  font-weight: $font-weight-bold;
  color: $color-text-primary;
  z-index: 1;
}

.hr-score__label {
  font-size: $font-size-xs;
  color: $color-text-tertiary;
}

.hr-metrics {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: $spacing-md;
}

.hr-metric {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: $spacing-sm;
  background: $color-bg-secondary;
  border-radius: $radius-sm;
}

.hr-metric__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: $radius-full;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;

  &--ok { background: rgba($color-success, 0.14); }
  &--warn { background: rgba($color-gold, 0.18); }
}

.hr-metric__name {
  font-size: $font-size-xs;
  color: $color-text-secondary;
}

.hr-metric__status {
  font-size: $font-size-xs;
  font-weight: $font-weight-semibold;

  &--ok { color: $color-success; }
  &--warn { color: $color-gold-deep; }
}

// —— 食欲趋势柱状 ——
.hr-bars {
  display: flex;
  align-items: flex-end;
  gap: $spacing-sm;
  height: 240rpx;
  margin-top: $spacing-lg;
  padding: 0 $spacing-sm;
}

.hr-bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  height: 100%;
  justify-content: flex-end;
}

.hr-bar__val {
  font-size: $font-size-xs;
  color: $color-text-secondary;
}

.hr-bar-track {
  width: 100%;
  max-width: 48rpx;
  height: 140rpx;
  display: flex;
  align-items: flex-end;
  background: $color-bg-secondary;
  border-radius: $radius-xs;
  overflow: hidden;
}

.hr-bar {
  width: 100%;
  border-radius: $radius-xs;
  background-image: linear-gradient(180deg, #7FE0B8 0%, $color-success 100%);
  min-height: 8rpx;

  &--warn {
    background-image: linear-gradient(180deg, $color-gold-soft 0%, $color-gold-deep 100%);
  }
}

.hr-bar__date {
  font-size: $font-size-xs;
  color: $color-text-tertiary;
}

.hr-legend {
  display: flex;
  gap: $spacing-lg;
  margin-top: $spacing-md;
  justify-content: center;
}

.hr-legend__item {
  display: flex;
  align-items: center;
  gap: $spacing-sm;
}

.hr-legend__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: $radius-full;

  &--ok { background: $color-success; }
  &--warn { background: $color-gold; }
}

.hr-legend__text {
  font-size: $font-size-xs;
  color: $color-text-tertiary;
}

// —— 异常记录 ——
.hr-anomalies,
.hr-meds {
  margin-top: $spacing-md;
  display: flex;
  flex-direction: column;
  gap: $spacing-md;
}

.hr-anomaly {
  padding: $spacing-md;
  background: $color-bg-secondary;
  border-radius: $radius-sm;
  border-left: 6rpx solid $color-gold;

  &__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: $spacing-sm;
  }

  &__date {
    font-size: $font-size-xs;
    color: $color-text-tertiary;
  }

  &__title {
    display: block;
    font-size: $font-size-sm;
    line-height: 1.6;
    color: $color-text-primary;
  }

  &__advice {
    display: block;
    margin-top: $spacing-sm;
    font-size: $font-size-xs;
    line-height: 1.6;
    color: $color-text-secondary;
  }
}

// —— 用药史 ——
.hr-med {
  display: flex;
  align-items: center;
  gap: $spacing-md;
  padding: $spacing-md;
  background: $color-bg-secondary;
  border-radius: $radius-sm;
}

.hr-med__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: $radius-full;
  background: $color-primary-bg;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.hr-med__info {
  flex: 1;
  min-width: 0;
}

.hr-med__name {
  display: block;
  font-size: $font-size-sm;
  font-weight: $font-weight-semibold;
  color: $color-text-primary;
}

.hr-med__meta {
  display: block;
  margin-top: 2rpx;
  font-size: $font-size-xs;
  color: $color-text-tertiary;
}

// 小 pill
.hr-pill-sm {
  padding: 4rpx $spacing-md;
  border-radius: $radius-round;
  flex-shrink: 0;

  &--warn { background: rgba($color-gold, 0.16); }
  &--error { background: $color-danger-bg; }
  &--ok { background: rgba($color-success, 0.14); }
}

.hr-pill-sm-text {
  font-size: $font-size-xs;
  font-weight: $font-weight-medium;

  .hr-pill-sm--warn & { color: $color-gold-deep; }
  .hr-pill-sm--error & { color: $color-danger; }
  .hr-pill-sm--ok & { color: $color-success; }
}

// 空态
.hr-empty {
  display: block;
  text-align: center;
  font-size: $font-size-sm;
  color: $color-text-placeholder;
  padding: $spacing-xl 0;
}

// —— 操作区 ——
.hr-actions {
  display: flex;
  gap: $spacing-md;
}

.hr-btn {
  flex: 1;
  padding: $spacing-lg 0;
  border-radius: $radius-round;
  text-align: center;
  @include press-feedback;

  &--primary {
    background-image: linear-gradient(135deg, $color-primary-light, $color-primary);
    box-shadow: $shadow-button;
  }

  &--ghost {
    background: $color-bg-card;
    border: 2rpx solid $color-border;
  }
}

.hr-btn-text {
  font-size: $font-size-sm;
  font-weight: $font-weight-bold;
  color: $color-text-inverse;

  &--ghost {
    color: $color-text-secondary;
  }
}

// —— 加载态 ——
.hr-loading {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(255, 246, 238, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: $spacing-md;
}

.hr-loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid $color-border;
  border-top-color: $color-primary;
  border-radius: $radius-full;
  animation: spin 0.8s linear infinite;
}

.hr-loading-text {
  font-size: $font-size-sm;
  color: $color-text-secondary;
}
