@import '../../styles/_theme';

.effect-page {
  min-height: 100vh;
  /* 背景由 <PageBackground /> 组件统一渲染，此处保持透明 */
  background: transparent;
  display: flex;
  flex-direction: column;
}

.effect-header {
  padding: 32rpx 32rpx 16rpx;
}

.effect-header-title {
  font-size: 36rpx;
  font-weight: 700;
  background: $gradient-gold;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: block;
}

.effect-header-sub {
  font-size: 24rpx;
  color: $color-text-secondary;
  margin-top: 8rpx;
  display: block;
}

.effect-scroll {
  flex: 1;
  padding: 0 32rpx;
}

// ===== 加载 =====
.effect-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.effect-loading Text {
  font-size: 28rpx;
  color: $color-text-secondary;
}

// ===== KPI卡片 =====
.effect-kpi-section {
  margin-bottom: 24rpx;
}

.effect-kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.effect-kpi-card {
  padding: 24rpx;
  border-radius: $radius-lg;
  background: $color-bg-card;
  border: 1px solid $color-border;
  display: flex;
  flex-direction: column;
  align-items: center;

  &--primary {
    border-color: rgba($color-primary, 0.3);
    background: $gradient-card;
  }
}

.effect-kpi-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.effect-kpi-value {
  font-size: 40rpx;
  font-weight: 700;
  color: $color-text-primary;
}

.effect-kpi-label {
  font-size: 22rpx;
  color: $color-text-secondary;
  margin-top: 4rpx;
}

.effect-kpi-desc {
  font-size: 20rpx;
  color: $color-text-hint;
  margin-top: 4rpx;
}

// ===== 通用区块 =====
.effect-section {
  margin-bottom: 28rpx;
}

.effect-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.effect-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: $color-text-primary;
}

.effect-section-action {
  padding: 8rpx 16rpx;
  border-radius: $radius-full;
  background: $color-primary-bg;
  border: 1px solid rgba($color-primary, 0.2);
}

.effect-section-action-text {
  font-size: 22rpx;
  color: $color-primary;
  font-weight: 500;
}

// ===== 宠物健康分列表 =====
.effect-pets-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.effect-pet-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: $radius-md;
  background: $color-bg-card;
  border: 1px solid $color-border;
}

.effect-pet-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba($color-primary-light, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;

  Text {
    font-size: 36rpx;
  }
}

.effect-pet-info {
  flex: 1;
}

.effect-pet-name {
  font-size: 28rpx;
  font-weight: 600;
  color: $color-text-primary;
}

.effect-pet-breed {
  font-size: 22rpx;
  color: $color-text-secondary;
  margin-top: 4rpx;
}

.effect-pet-score {
  display: flex;
  align-items: center;
  gap: 8rpx;

  &--green .effect-pet-score-value { color: #6BC89D; }
  &--gold .effect-pet-score-value { color: #E8C878; }
  &--red .effect-pet-score-value { color: #E0856B; }
}

.effect-pet-score-value {
  font-size: 32rpx;
  font-weight: 700;
}

.effect-pet-score-trend {
  font-size: 24rpx;
}

// ===== 使用统计 =====
.effect-stats-grid {
  display: flex;
  gap: 16rpx;
}

.effect-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  border-radius: $radius-md;
  background: $color-bg-card;
  border: 1px solid $color-border;
}

.effect-stat-label {
  font-size: 22rpx;
  color: $color-text-secondary;
  margin-bottom: 8rpx;
}

.effect-stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: $color-text-primary;

  &--green { color: #6BC89D; }
  &--red { color: #E0856B; }
}

.effect-stat-unit {
  font-size: 20rpx;
  color: $color-text-hint;
  margin-top: 4rpx;
}

// ===== 空状态 =====
.effect-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx;
}

.effect-empty-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
  opacity: 0.6;
}

.effect-empty-text {
  font-size: 26rpx;
  color: $color-text-secondary;
  margin-bottom: 8rpx;
}

.effect-empty-hint {
  font-size: 22rpx;
  color: $color-text-hint;
  text-align: center;
  line-height: 1.6;
}

// ===== 建议卡片列表 =====
.effect-suggestions-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.effect-suggestion-card {
  padding: 20rpx;
  border-radius: $radius-md;
  background: $color-bg-card;
  border: 1px solid $color-border;
  position: relative;

  &--adopted {
    opacity: 0.7;
  }
}

.effect-suggestion-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.effect-suggestion-type {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.effect-suggestion-type-icon {
  font-size: 24rpx;
}

.effect-suggestion-type-label {
  font-size: 22rpx;
  color: $color-text-secondary;
}

.effect-suggestion-priority {
  padding: 2rpx 12rpx;
  border-radius: $radius-sm;
  font-size: 20rpx;

  &--high {
    background: rgba(#E0856B, 0.15);
    color: #E0856B;
  }

  &--medium {
    background: rgba(#E8C878, 0.15);
    color: #C8A838;
  }

  &--low {
    background: rgba(#6BC89D, 0.15);
    color: #4BA878;
  }
}

.effect-suggestion-title {
  font-size: 28rpx;
  font-weight: 600;
  color: $color-text-primary;
  display: block;
  margin-bottom: 8rpx;
}

.effect-suggestion-content {
  font-size: 24rpx;
  color: $color-text-secondary;
  line-height: 1.5;
  display: block;
  margin-bottom: 12rpx;
}

.effect-suggestion-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.effect-suggestion-pet {
  font-size: 22rpx;
  color: $color-text-hint;
}

.effect-suggestion-time {
  font-size: 22rpx;
  color: $color-text-hint;
}

.effect-suggestion-adopted-badge {
  padding: 8rpx 16rpx;
  border-radius: $radius-sm;
  background: rgba(#6BC89D, 0.1);
  display: inline-flex;
  align-items: center;
  /* 图标与文字间距（原来 emoji 内联在文字里） */
  gap: 6rpx;

  Text {
    font-size: 22rpx;
    color: #4BA878;
    font-weight: 500;
  }
}

.effect-suggestion-actions {
  display: flex;
  gap: 12rpx;
}

.effect-suggestion-btn {
  padding: 10rpx 24rpx;
  border-radius: $radius-sm;
  font-size: 24rpx;
  font-weight: 500;

  &--adopt {
    background: $color-primary;
    color: #fff;
  }

  &--dismiss {
    background: rgba($color-text-secondary, 0.1);
    color: $color-text-secondary;
  }

  &:active {
    opacity: 0.7;
  }
}

// ===== 底部安全区 =====
.effect-bottom-safe {
  height: 80rpx;
}