@import '../../styles/_theme';
@import '../../styles/_animations';

.pet-food-query {
  min-height: 100vh;
  /* 背景统一由 <PageBackground /> 组件渲染（含星空/格纹/照片壁纸），此处保持透明 */
  background: transparent;
  padding: 32rpx 24rpx;
  padding-bottom: 200rpx;
  position: relative;
}

.pet-food-query__loading {
  @include flex-center;
  padding: 80rpx 0;
}

.pet-food-query__loading-text {
  font-size: $font-size-sm;
  color: $color-text-tertiary;
}

/* ===== 空状态 ===== */
.pet-food-query__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx 40rpx;
}

.pet-food-query__empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.pet-food-query__empty-text {
  font-size: $font-size-md;
  color: $color-text-tertiary;
  text-align: center;
  line-height: 1.6;
}

.pet-food-query__empty-examples {
  margin-top: 32rpx;
  text-align: center;
}

.pet-food-query__empty-examples-title {
  display: block;
  font-size: $font-size-xs;
  color: $color-text-hint;
  margin-bottom: 16rpx;
}

.pet-food-query__empty-example-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}

.pet-food-query__empty-example-chip {
  font-size: $font-size-sm;
  color: $color-primary-light;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  background: rgba($color-primary, 0.08);
  border: 1px solid rgba($color-primary, 0.15);
  transition: all 0.3s ease;
  @include press-feedback;
}

.pet-food-query__empty-example-chip:active {
  background: rgba($color-primary, 0.2);
  transform: scale(0.95);
}

/* ===== 搜索栏 ===== */
.pet-food-query__search {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 10;
}

// 渐变胶囊包裹（原型对齐）
.pet-food-query__search-glow {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, $color-primary-light, $color-primary);
  box-shadow: $shadow-button;
  min-height: 96rpx;
}

.pet-food-query__search-input-wrapper {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  background: $color-bg-card;
  border-radius: 999rpx;
  border: 1rpx solid $color-border;
  transition: border-color $transition-normal;
  min-height: 80rpx;
}

.pet-food-query__search-input-wrapper:focus-within {
  border-color: $color-primary-light;
  box-shadow: 0 0 0 2rpx rgba($color-primary-light, 0.15);
}

.pet-food-query__search-icon {
  font-size: 32rpx;
  padding-left: 28rpx;
  flex-shrink: 0;
}

.pet-food-query__input {
  flex: 1;
  height: 80rpx;
  padding: 0 16rpx;
  font-size: $font-size-md;
  color: $color-text-primary;
  background: transparent;
  border: none;
  box-sizing: border-box;
  min-width: 0;
}

.pet-food-query__input-placeholder {
  color: $color-text-placeholder;
}

.pet-food-query__search-clear {
  font-size: 28rpx;
  color: $color-text-tertiary;
  padding: 0 20rpx;
  flex-shrink: 0;
  @include press-feedback;
}

.pet-food-query__search-btn {
  min-width: 128rpx;
  height: 80rpx;
  background: transparent;
  color: $color-text-inverse;
  font-size: $font-size-md;
  font-weight: $font-weight-semibold;
  border-radius: 999rpx;
  @include flex-center;
  flex-shrink: 0;
  @include press-feedback;
}

.pet-food-query__search-btn--disabled {
  opacity: 0.4;
  box-shadow: none;
}

/* ===== 状态说明条（原型对齐：安全/注意/有毒） ===== */
.pet-food-query__legend {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.pet-food-query__legend-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 8rpx;
  border-radius: $radius-md;
  text-align: center;

  &--safe {
    background: rgba($color-success, 0.12);
    border: 1rpx solid rgba($color-success, 0.26);
  }

  &--warning {
    background: rgba($color-warning, 0.12);
    border: 1rpx solid rgba($color-warning, 0.26);
  }

  &--toxic {
    background: rgba($color-danger, 0.12);
    border: 1rpx solid rgba($color-danger, 0.26);
  }
}

.pet-food-query__legend-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: $color-text-inverse;

  &--safe { background: $color-success; }
  &--warning { background: $color-warning; }
  &--toxic { background: $color-danger; }
}

.pet-food-query__legend-label {
  font-size: $font-size-xs;
  font-weight: $font-weight-semibold;
  line-height: 1;

  &--safe { color: $color-success; }
  &--warning { color: $color-warning; }
  &--toxic { color: $color-danger; }
}

.pet-food-query__legend-desc {
  font-size: 22rpx;
  line-height: 1;
  color: $color-text-secondary;
}

/* ===== 搜索建议下拉 ===== */
.pet-food-query__suggestions {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  margin-top: 8rpx;
  background: $color-bg-card;
  border: 1px solid $color-border;
  border-radius: 20rpx;
  padding: 12rpx 0;
  z-index: 100;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.3);
  max-height: 400rpx;
  overflow-y: auto;
}

.pet-food-query__suggestion-item {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  gap: 16rpx;
  transition: background $transition-fast;
  @include press-feedback;
}

.pet-food-query__suggestion-item:active {
  background: $color-primary-bg;
}

.pet-food-query__suggestion-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.pet-food-query__suggestion-text {
  font-size: $font-size-sm;
  color: $color-text-primary;
}

/* ===== 快捷分类 ===== */
.pet-food-query__categories {
  margin-bottom: 16rpx;
  white-space: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  padding: 4rpx 0;
}

.pet-food-query__category-group {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-right: 24rpx;
  padding: 12rpx 16rpx;
  background: $color-primary-bg;
  border: 1px solid $color-border;
  border-radius: 40rpx;
  vertical-align: top;
}

.pet-food-query__category-label {
  font-size: 22rpx;
  color: $color-text-secondary;
  font-weight: $font-weight-semibold;
  flex-shrink: 0;
}

.pet-food-query__category-chips {
  display: inline-flex;
  gap: 8rpx;
  flex-wrap: nowrap;
}

.pet-food-query__category-chip {
  display: inline-block;
  font-size: 22rpx;
  color: $color-text-primary;
  padding: 6rpx 18rpx;
  border-radius: 30rpx;
  background: $color-bg-card;
  border: 1px solid transparent;
  transition: all 0.25s ease;
  @include press-feedback;
}

.pet-food-query__category-chip:active {
  background: rgba($color-primary, 0.2);
  transform: scale(0.95);
}

.pet-food-query__category-chip--active {
  background: $color-primary;
  color: $color-text-inverse;
  border-color: $color-primary;
}

/* ===== 查询配额 ===== */
.pet-food-query__quota {
  font-size: $font-size-xs;
  color: $color-text-tertiary;
  text-align: center;
  margin-bottom: 12rpx;
  padding: 10rpx 24rpx;
  @include card-base;
}

.pet-food-query__quota--exhausted {
  color: $color-danger;
  font-weight: $font-weight-semibold;
}

/* ===== 查询结果 ===== */
.pet-food-query__result {
  @include card-base;
  padding: 32rpx;
  margin-bottom: 24rpx;
  animation: fadeInUp 0.4s ease-out;
  overflow: hidden;
  position: relative;
}

.pet-food-query__result::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 100%;
  border-radius: 0 4rpx 4rpx 0;
}

.pet-food-query__result--safe::before { background: $color-success; }
.pet-food-query__result--caution::before { background: $color-primary; }
.pet-food-query__result--dangerous::before { background: $color-primary-dark; }
.pet-food-query__result--toxic::before { background: $color-danger; }

.pet-food-query__result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.pet-food-query__result-name {
  font-size: $font-size-xl;
  font-weight: $font-weight-bold;
  color: $color-text-primary;
}

.pet-food-query__result-badge {
  font-size: $font-size-xs;
  font-weight: $font-weight-semibold;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  color: #FFFFFF;
}

.pet-food-query__result-badge--safe { background: $color-success; }
.pet-food-query__result-badge--caution { background: $color-primary; color: $color-text-inverse; }
.pet-food-query__result-badge--dangerous { background: $color-primary-dark; }
.pet-food-query__result-badge--toxic { background: $color-danger; }

.pet-food-query__result-section {
  margin-top: 20rpx;
  padding-left: 8rpx;
}

.pet-food-query__result-section-title {
  /* 图标 + 文字水平排列（原来 emoji 内联在标题文字里） */
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: $font-size-sm;
  font-weight: $font-weight-semibold;
  color: $color-text-primary;
  margin-bottom: 12rpx;
}

.pet-food-query__result-section-text {
  display: block;
  font-size: $font-size-sm;
  color: $color-text-secondary;
  line-height: 1.7;
}

.pet-food-query__result-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pet-food-query__result-tag {
  font-size: $font-size-xs;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: rgba($color-primary, 0.08);
  color: $color-text-secondary;
  animation: fadeIn 0.3s ease-out;
}

.pet-food-query__result-tag--danger {
  background: $color-danger-bg;
  color: $color-danger;
}

.pet-food-query__result-firstaid {
  margin-top: 24rpx;
  padding: 24rpx;
  background: $color-danger-bg;
  border: 2rpx solid $color-danger;
  border-radius: 24rpx;
}

.pet-food-query__result-firstaid-title {
  display: block;
  font-size: $font-size-sm;
  font-weight: $font-weight-bold;
  color: $color-danger;
  margin-bottom: 12rpx;
}

.pet-food-query__result-firstaid-text {
  display: block;
  font-size: $font-size-sm;
  color: $color-danger;
  line-height: 1.7;
}

/* ===== 分享按钮 ===== */
.pet-food-query__result-share-btn {
  margin-top: 24rpx;
  padding: 24rpx;
  background: $gradient-card;
  border: 1px solid $color-border;
  border-radius: 24rpx;
  text-align: center;
  @include press-feedback;
  transition: all 0.3s ease;
}

.pet-food-query__result-share-btn:active {
  transform: scale(0.97);
}

.pet-food-query__result-share-btn-text {
  font-size: $font-size-md;
  font-weight: $font-weight-semibold;
  color: $color-primary-light;
}

/* ===== 查询历史 ===== */
.pet-food-query__history {
  margin-top: 24rpx;
}

.pet-food-query__history-title {
  display: block;
  font-size: $font-size-md;
  font-weight: $font-weight-semibold;
  color: $color-text-primary;
  margin-bottom: 16rpx;
}

.pet-food-query__history-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pet-food-query__history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  @include card-base;
  padding: 24rpx 28rpx;
  @include press-feedback;
  transition: all 0.25s ease;
  border-left: 6rpx solid transparent;
}

.pet-food-query__history-item:active {
  transform: scale(0.98);
  background: $color-bg-secondary;
}

.pet-food-query__history-item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.pet-food-query__history-item-name {
  font-size: $font-size-md;
  font-weight: $font-weight-medium;
  color: $color-text-primary;
  @include text-ellipsis;
}

.pet-food-query__history-item-badge {
  font-size: 22rpx;
  font-weight: $font-weight-semibold;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.pet-food-query__history-item-time {
  font-size: 22rpx;
  color: $color-text-tertiary;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ===== 品种特殊禁忌 ===== */
.pet-food-query__result-section--breed {
  background: $color-bg-secondary;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.pet-food-query__breed-warning {
  @include card-base;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid $color-primary;
}

.pet-food-query__breed-warning:last-child {
  margin-bottom: 0;
}

.pet-food-query__breed-warning-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.pet-food-query__breed-warning-name {
  font-size: $font-size-md;
  font-weight: $font-weight-semibold;
  color: $color-text-primary;
}

.pet-food-query__breed-warning-level {
  font-size: 22rpx;
  font-weight: $font-weight-semibold;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  color: #FFFFFF;
}

.pet-food-query__breed-warning-level--toxic { background: $color-danger; }
.pet-food-query__breed-warning-level--dangerous { background: $color-primary-dark; }
.pet-food-query__breed-warning-level--caution { background: $color-primary; color: $color-text-inverse; }
.pet-food-query__breed-warning-level--info { background: $color-teal; }

.pet-food-query__breed-warning-reason {
  display: block;
  font-size: $font-size-sm;
  color: $color-text-secondary;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.pet-food-query__breed-warning-recommendation {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  background: rgba(140, 173, 126, 0.08);
  border: 1px solid rgba(140, 173, 126, 0.15);
  border-radius: 16rpx;
  padding: 16rpx;
}

.pet-food-query__breed-warning-recommendation-label {
  font-size: $font-size-xs;
  font-weight: $font-weight-semibold;
  color: $color-success;
  flex-shrink: 0;
}

.pet-food-query__breed-warning-recommendation-text {
  font-size: $font-size-xs;
  color: $color-success;
  line-height: 1.5;
  flex: 1;
}

/* ===== 免责声明（金色安全提示条） ===== */
.pet-food-query__disclaimer {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background: #FFF6DC;
  border: 1px solid rgba(255, 176, 32, 0.28);
  border-radius: 12rpx;
  margin-top: 24rpx;
}

.pet-food-query__disclaimer-icon {
  font-size: 32rpx;
  line-height: 1;
  flex-shrink: 0;
}

.pet-food-query__disclaimer-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: $color-text-secondary;
  line-height: 1.5;
}
