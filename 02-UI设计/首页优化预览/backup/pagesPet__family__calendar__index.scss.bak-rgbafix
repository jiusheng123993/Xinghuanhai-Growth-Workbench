@import '../../../styles/_theme';
@import '../../../styles/_animations';

.calendar-page {
  min-height: 100vh;
  background: $gradient-page;
  padding: 20rpx 16rpx;
  padding-top: 60rpx;
  display: flex;
  flex-direction: column;
  animation: pageEnter 0.4s ease-out;
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  gap: 24rpx;

  &__nav {
    color: $color-primary;
    font-size: 36rpx;
    padding: 8rpx;
    @include press-feedback;
  }

  &__title {
    color: $color-text-primary;
    font-size: 40rpx;
    font-family: 'STSong', 'SimSun', serif;
    min-width: 240rpx;
    text-align: center;
  }
}

.calendar-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 8rpx;

  &__item {
    color: $color-text-hint;
    font-size: 24rpx;
    text-align: center;
    padding: 12rpx 0;
  }
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
  margin-bottom: 16rpx;

  &__cell {
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 20rpx;
    background: transparent;
    border: 2rpx solid transparent;
    position: relative;
    @include press-feedback;

    &--empty {
      cursor: default;
    }

    &--today {
      border-color: $color-primary;
    }

    &--selected {
      background: rgba($color-primary, 0.15);
    }
  }

  &__day {
    color: $color-text-primary;
    font-size: 28rpx;
  }

  &__dot {
    width: 10rpx;
    height: 10rpx;
    border-radius: 50%;
    background: $color-primary;
    margin-top: 6rpx;

    &--danger {
      background: $color-danger;
    }
  }
}

.calendar-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;

  &__text {
    color: $color-text-hint;
    font-size: 28rpx;
  }
}

.calendar-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  gap: 32rpx;

  &__text {
    color: $color-danger;
    font-size: 30rpx;
  }

  &__btn {
    padding: 20rpx 64rpx;
    border-radius: 40rpx;
    background: $gradient-warm;
    @include press-feedback;

    Text {
      color: $color-text-inverse;
      font-size: 28rpx;
      font-weight: 600;
    }
  }
}

.calendar-events {
  flex: 1;
  margin-top: 8rpx;
  min-height: 0;

  &__date {
    color: $color-text-hint;
    font-size: 26rpx;
    margin-bottom: 24rpx;
    display: block;
  }

  &__loading {
    color: $color-text-hint;
    font-size: 26rpx;
    text-align: center;
    padding: 40rpx;
    display: block;
  }

  &__empty {
    color: $color-text-hint;
    font-size: 26rpx;
    text-align: center;
    padding: 40rpx;
    display: block;
  }

  &__placeholder {
    color: $color-text-tertiary;
    font-size: 26rpx;
    text-align: center;
    padding: 48rpx;
    display: block;
  }

  &__item {
    padding: 28rpx 32rpx;
    border-radius: 24rpx;
    margin-bottom: 16rpx;
    background: $color-bg-card;
    border: 2rpx solid $color-border;
    border-left-width: 6rpx;
    border-left-style: solid;
    display: flex;
    align-items: center;
    gap: 24rpx;
    animation: cardStaggerIn 0.35s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }

  &__item-emoji {
    font-size: 40rpx;
    flex-shrink: 0;
  }

  &__item-body {
    flex: 1;
    min-width: 0;
  }

  &__item-title {
    color: $color-text-primary;
    font-size: 28rpx;
    display: block;
    margin-bottom: 8rpx;
  }

  &__item-meta {
    display: flex;
    align-items: center;
    gap: 16rpx;
  }

  &__item-pet {
    color: $color-text-hint;
    font-size: 22rpx;
  }

  &__item-type {
    font-size: 22rpx;
    padding: 2rpx 16rpx;
    border-radius: 8rpx;
    background: $color-primary-bg;
  }
}

.calendar-footer {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid $color-divider;

  &__btn {
    flex: 1;
    padding: 24rpx 0;
    border-radius: 40rpx;
    background: $gradient-warm;
    text-align: center;
    @include press-feedback;
  }

  &__btn-text {
    color: $color-text-inverse;
    font-size: 28rpx;
    font-weight: 600;
  }
}