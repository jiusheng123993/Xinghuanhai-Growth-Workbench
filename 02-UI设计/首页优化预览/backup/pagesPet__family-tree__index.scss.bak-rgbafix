@import '../../styles/_theme';
@import '../../styles/_animations';

// ============================================
// 家族图谱页 — 原型 1:1：头部卡 + 三代树形图 + 成员列表
// ============================================

.family-tree {
  min-height: 100vh;
  /* 背景统一由 <PageBackground /> 组件渲染（含星空/格纹/照片壁纸），此处保持透明 */
  background: transparent;
  position: relative;
  z-index: 1;
  animation: pageEnter 0.4s ease-out;
}

.family-tree__content {
  position: relative;
  z-index: 2;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

// ===== 空态/加载 =====
.family-tree__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
}

.family-tree__empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.family-tree__empty-text {
  font-size: $font-size-sm;
  color: $color-text-tertiary;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.family-tree__empty-btn {
  padding: 20rpx 48rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, $color-primary, $color-primary-dark);
  box-shadow: $shadow-button;
}

.family-tree__empty-btn Text {
  font-size: $font-size-sm;
  font-weight: $font-weight-semibold;
  color: #FFFFFF;
}

.family-tree__loading {
  @include flex-center;
  padding: 80rpx 0;
}

.family-tree__loading-text {
  font-size: $font-size-sm;
  color: $color-text-tertiary;
}

.family-tree__safe {
  height: 40rpx;
}

// ===== 通用卡片 =====
.ft-card {
  @include card-base;
  padding: 32rpx;
  animation: fadeInUp 0.35s ease-out;
}

.ft-card__section-title {
  /* 图标 + 文字水平排列（原来 emoji 内联在标题文字里） */
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: $font-size-md;
  font-weight: $font-weight-semibold;
  color: $color-text-secondary;
  margin-bottom: 28rpx;
}

// ===== 图谱头部卡 =====
.ft-card__head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ft-card__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, $color-primary-light, $color-primary);
  @include flex-center;
  flex-shrink: 0;
  box-shadow: $shadow-sm;
}

.ft-card__avatar-icon {
  font-size: 40rpx;
  line-height: 1;
}

.ft-card__info {
  flex: 1;
  min-width: 0;
}

.ft-card__name {
  display: block;
  font-size: $font-size-lg;
  font-weight: $font-weight-bold;
  color: $color-text-primary;
  @include text-ellipsis;
}

.ft-card__meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 4rpx;
}

.ft-card__meta-icon {
  font-size: 24rpx;
  line-height: 1;
}

.ft-card__meta-text {
  font-size: 22rpx;
  color: $color-text-tertiary;
}

.ft-card__edit {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: $color-primary-bg;
  flex-shrink: 0;
}

.ft-card__edit:active {
  opacity: 0.8;
}

.ft-card__edit-icon {
  font-size: 24rpx;
  line-height: 1;
}

.ft-card__edit-text {
  font-size: 22rpx;
  font-weight: $font-weight-semibold;
  color: $color-primary;
}

// ===== 三代树形图 =====
.ft-tree-row-title {
  display: block;
  font-size: 22rpx;
  font-weight: $font-weight-semibold;
  color: $color-text-tertiary;
  text-align: center;
  margin-bottom: 20rpx;
}

.ft-tree-row,
.ft-tree-parents {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  padding: 8rpx 0;
}

.ft-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 128rpx;
}

.ft-avatar-wrap {
  position: relative;
}

.ft-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid $color-primary;
  overflow: hidden;
  @include flex-center;
  background: $color-primary-bg;

  // 铲屎官根节点头像（2026-08-24）：金色渐变，与宠物节点区分
  &--owner {
    border-color: $color-gold;
    background: linear-gradient(135deg, rgba($color-gold, 0.35), rgba($color-primary, 0.2));
  }
}

.ft-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.ft-avatar-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.ft-node-name {
  display: block;
  font-size: $font-size-sm;
  font-weight: $font-weight-semibold;
  color: $color-text-primary;
  margin-top: 12rpx;
  max-width: 128rpx;
  @include text-ellipsis;
}

.ft-node-role {
  display: block;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: $color-primary-bg;
  font-size: 20rpx;
  font-weight: $font-weight-semibold;
  color: $color-primary;
  max-width: 128rpx;
  @include text-ellipsis;
}

.ft-tree-empty-row {
  font-size: 22rpx;
  color: $color-text-placeholder;
  padding: 24rpx 0;
}

// ===== 连接线 =====
.ft-connector {
  display: flex;
  justify-content: center;
  height: 56rpx;
}

.ft-connector-v {
  width: 4rpx;
  height: 100%;
  background: $color-primary;
  border-radius: 2rpx;

  &--dash {
    border-left: 4rpx dashed $color-primary;
    background: transparent;
  }
}

// ===== 图例 =====
.ft-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid $color-border;
}

.ft-legend__item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.ft-legend__line {
  width: 40rpx;
  height: 4rpx;
  border-radius: 2rpx;

  &--solid {
    background: $color-primary;
  }

  &--dash {
    border-top: 4rpx dashed $color-primary;
    background: transparent;
  }
}

.ft-legend__text {
  font-size: 22rpx;
  color: $color-text-tertiary;
}

// ===== 家庭成员列表 =====
.ft-member-list {
  display: flex;
  flex-direction: column;
}

.ft-member-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid $color-border-light;
  transition: background $transition-fast;

  &--active {
    background: rgba($color-primary, 0.04);
    border-radius: 16rpx;
    padding-left: 12rpx;
    padding-right: 12rpx;
  }
}

.ft-member-row:last-child {
  border-bottom: none;
}

.ft-member-row:active {
  background: rgba($color-primary, 0.06);
}

.ft-member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  @include flex-center;
  background: $color-primary-bg;
  flex-shrink: 0;
}

.ft-member-avatar-img {
  width: 100%;
  height: 100%;
}

.ft-member-avatar-emoji {
  font-size: 40rpx;
  line-height: 1;
}

.ft-member-info {
  flex: 1;
  min-width: 0;
}

.ft-member-name {
  display: block;
  font-size: $font-size-sm;
  font-weight: $font-weight-semibold;
  color: $color-text-primary;
  @include text-ellipsis;
}

.ft-member-rel {
  display: block;
  font-size: 22rpx;
  color: $color-text-tertiary;
  margin-top: 4rpx;
}

.ft-member-role {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: $color-primary-bg;
}

.ft-member-role-text {
  font-size: 20rpx;
  font-weight: $font-weight-semibold;
  color: $color-primary;
}

.ft-member-arrow {
  font-size: 32rpx;
  color: $color-text-tertiary;
  flex-shrink: 0;
}

// ===== 家庭成员（人）卡：人节点 + 人关系（2026-08-24） =====
.ft-user-list {
  display: flex;
  flex-direction: column;
}

.ft-user-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid $color-border-light;

  &:last-child {
    border-bottom: none;
  }
}

.ft-user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  @include flex-center;
  background: linear-gradient(135deg, rgba($color-gold, 0.28), rgba($color-primary, 0.18));
  flex-shrink: 0;
}

.ft-user-avatar-text {
  font-size: 34rpx;
  font-weight: $font-weight-bold;
  color: $color-primary-dark;
  line-height: 1;
}

.ft-user-info {
  flex: 1;
  min-width: 0;
}

.ft-user-name {
  display: block;
  font-size: $font-size-sm;
  font-weight: $font-weight-semibold;
  color: $color-text-primary;
  @include text-ellipsis;
}

.ft-user-role {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: $color-bg-secondary;

  &--owner {
    background: rgba($color-gold, 0.22);
  }
}

.ft-user-role text {
  font-size: 20rpx;
  font-weight: $font-weight-semibold;
  color: $color-text-secondary;
}

.ft-user-role--owner text {
  color: $color-gold-deep;
}

// 人关系列表
.ft-rel-list {
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid $color-border-light;
}

.ft-rel-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid $color-border-light;

  &:last-child {
    border-bottom: none;
  }
}

.ft-rel-emoji {
  font-size: 36rpx;
  line-height: 1;
  flex-shrink: 0;
}

.ft-rel-text {
  flex: 1;
  font-size: $font-size-sm;
  color: $color-text-primary;
  @include text-ellipsis;
}

.ft-rel-remove {
  @include flex-center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba($color-danger, 0.1);
  font-size: 24rpx;
  color: $color-danger;
  flex-shrink: 0;
  @include press-feedback;
}

// ===== 关系管理入口 =====
.ft-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid $color-border;
}

.ft-action {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  @include flex-center;
  transition: all $transition-fast;

  &:active {
    transform: scale(0.97);
  }
}

.ft-action--primary {
  background: linear-gradient(135deg, $color-primary, $color-primary-dark);
  box-shadow: $shadow-button;
}

.ft-action--outline {
  border: 2rpx solid $color-primary;
  background: $color-bg-card;
}

.ft-action__text {
  font-size: $font-size-sm;
  font-weight: $font-weight-semibold;
  color: #FFFFFF;

  .ft-action--outline & {
    color: $color-primary;
  }
}

// ===== 关系弹窗 =====
.relation-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 70vh;
  background: $color-bg-card;
  border-radius: $radius-xl $radius-xl 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.15);
  z-index: 100;
  padding: 24rpx 0 40rpx;
}

.relation-panel__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 16rpx;
  border-bottom: 1rpx solid rgba($color-text-primary, 0.06);
}

.relation-panel__title {
  font-size: 30rpx;
  font-weight: 600;
  color: $color-text-primary;
}

.relation-panel__close {
  font-size: 24rpx;
  color: $color-text-tertiary;
  padding: 8rpx;
}

.relation-panel__body {
  padding: 24rpx 32rpx;
  max-height: 50vh;
  overflow-y: auto;
}

.relation-form__field {
  margin-bottom: 24rpx;
}

.relation-form__label {
  font-size: 26rpx;
  color: $color-text-secondary;
  margin-bottom: 12rpx;
  display: block;
}

.relation-form__picker {
  padding: 20rpx 24rpx;
  border-radius: $radius-md;
  background: rgba($color-text-primary, 0.04);
  font-size: 28rpx;
  color: $color-text-primary;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.relation-form__picker-placeholder {
  color: $color-text-tertiary;
}

.relation-form__type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.relation-form__type-item {
  padding: 14rpx 24rpx;
  border-radius: $radius-round;
  font-size: 24rpx;
  color: $color-text-secondary;
  background: rgba($color-text-primary, 0.04);
  transition: $transition-fast;

  &--active {
    background: $color-primary;
    color: #fff;
  }
}

.relation-form__submit {
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: $radius-round;
  background: linear-gradient(135deg, $color-primary, $color-primary-dark);
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

// ===== 遮罩 =====
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 99;
}
