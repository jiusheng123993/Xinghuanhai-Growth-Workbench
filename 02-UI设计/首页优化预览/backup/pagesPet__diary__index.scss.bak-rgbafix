@import '../../styles/_theme';
@import '../../styles/_animations';

// ============================================
// 宠物日记页 — 原型 1:1：头部卡 + 心情筛选 + 时间轴 + 写日记 FAB
// ============================================

.pet-diary {
  min-height: 100vh;
  /* 背景统一由 <PageBackground /> 组件渲染（含星空/格纹/照片壁纸），此处保持透明 */
  background: transparent;
  position: relative;
  z-index: 1;
  padding-bottom: 200rpx;
  animation: pageEnter 0.4s ease-out;
}

.pet-diary__content {
  position: relative;
  z-index: 2;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

// ===== 日记头部卡 =====
.pdiary-head {
  background: $color-bg-card;
  border: 2rpx solid $color-border;
  border-radius: 24rpx;
  box-shadow: $shadow-card;
  padding: 32rpx;
  animation: fadeInUp 0.35s ease-out;
}

.pdiary-head__row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.pdiary-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, $color-primary-light, $color-primary);
  @include flex-center;
  flex-shrink: 0;
  box-shadow: $shadow-button;
}

.pdiary-avatar__emoji {
  font-size: 56rpx;
  line-height: 1;
}

.pdiary-head__info {
  flex: 1;
  min-width: 0;
}

.pdiary-head__name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.pdiary-head__name {
  font-size: $font-size-xl;
  font-weight: $font-weight-bold;
  color: $color-text-primary;
  @include text-ellipsis;
}

.pdiary-head__meta {
  flex-shrink: 0;
  font-size: 22rpx;
  color: $color-text-tertiary;
}

.pdiary-head__slogan {
  display: block;
  font-size: 22rpx;
  color: $color-text-secondary;
  margin-top: 6rpx;
}

.pdiary-head__stats {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.pdiary-stat {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.pdiary-stat__icon {
  font-size: 24rpx;
  line-height: 1;
}

.pdiary-stat__text {
  font-size: 22rpx;
  color: $color-text-tertiary;
}

.pdiary-stat__num {
  font-size: 22rpx;
  font-weight: $font-weight-bold;
  color: $color-primary;
}

// ===== 心情筛选行 =====
.pdiary-filters {
  width: 100%;
  white-space: nowrap;
}

.pdiary-filters__inner {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.pdiary-filter {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: $color-bg-card;
  border: 2rpx solid $color-border;
  flex-shrink: 0;
  transition: all $transition-fast;

  &--active {
    background: linear-gradient(135deg, $color-primary-light, $color-primary);
    border-color: transparent;
    box-shadow: $shadow-button;
  }
}

.pdiary-filter__text {
  font-size: $font-size-sm;
  color: $color-text-secondary;

  .pdiary-filter--active & {
    color: #FFFFFF;
    font-weight: $font-weight-semibold;
  }
}

// ===== 时间轴 =====
.pdiary-scroll {
  flex: 1;
  min-height: 400rpx;
}

.pdiary-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.pdiary-section-title {
  font-size: $font-size-md;
  font-weight: $font-weight-semibold;
  color: $color-text-secondary;
}

.pdiary-section-count {
  font-size: 22rpx;
  color: $color-text-tertiary;
}

.pdiary-timeline {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pdiary-item {
  display: flex;
  gap: 20rpx;
}

.pdiary-rail {
  position: relative;
  width: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.pdiary-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-top: 16rpx;
  flex-shrink: 0;
  border: 4rpx solid $color-bg-card;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.pdiary-rail__line {
  flex: 1;
  width: 4rpx;
  background: $color-border;
  border-radius: 2rpx;
  margin-top: 8rpx;
}

.pdiary-card {
  flex: 1;
  min-width: 0;
  background: $color-bg-card;
  border-radius: 24rpx;
  box-shadow: $shadow-card;
  padding: 28rpx;
  margin-bottom: 20rpx;
  animation: fadeInUp 0.35s ease-out;
}

.pdiary-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.pdiary-date {
  font-size: 22rpx;
  color: $color-text-secondary;
}

.pdiary-mood {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.pdiary-mood__text {
  font-size: 20rpx;
  font-weight: $font-weight-semibold;
  color: #FFFFFF;
}

.pdiary-photo {
  height: 200rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, $color-primary-bg, $color-bg-secondary);
  @include flex-center;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.pdiary-photo__emoji {
  font-size: 64rpx;
  line-height: 1;
}

.pdiary-photo__caption {
  font-size: 20rpx;
  color: $color-text-tertiary;
}

.pdiary-card__text {
  display: block;
  font-size: $font-size-sm;
  color: $color-text-primary;
  line-height: 1.8;
}

.pdiary-note {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: $color-bg-secondary;
  border-radius: 16rpx;
}

.pdiary-note__label {
  font-size: 22rpx;
  color: $color-text-tertiary;
}

.pdiary-note__text {
  font-size: 22rpx;
  color: $color-text-secondary;
  line-height: 1.6;
}

.pdiary-card__actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.pdiary-card__share {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: $color-primary-bg;
}

.pdiary-card__share:active {
  opacity: 0.8;
}

.pdiary-card__share-text {
  font-size: 20rpx;
  color: $color-primary;
  font-weight: $font-weight-medium;
}

// ===== 空态 / 加载 / 错误 =====
.pet-diary__loading,
.pet-diary__error,
.pet-diary__empty {
  @include card-base;
  padding: 80rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.pet-diary__loading-text,
.pet-diary__error-text,
.pet-diary__empty-text {
  font-size: $font-size-sm;
  color: $color-text-tertiary;
  text-align: center;
}

.pet-diary__empty-icon {
  font-size: 72rpx;
}

.pet-diary__empty-hint {
  font-size: 22rpx;
  color: $color-text-placeholder;
}

.pet-diary__retry-btn {
  margin-top: 12rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, $color-primary, $color-primary-dark);
}

.pet-diary__retry-text {
  font-size: $font-size-sm;
  font-weight: $font-weight-semibold;
  color: #FFFFFF;
}

// ===== 免责声明 =====
.pet-diary__disclaimer {
  position: relative;
  z-index: 2;
  margin: 24rpx 24rpx 0;
  padding: 20rpx;
  background: rgba($color-primary, 0.06);
  border: 1px solid rgba($color-primary, 0.12);
  border-radius: 16rpx;
}

.pet-diary__disclaimer-text {
  font-size: 22rpx;
  color: $color-primary-light;
  line-height: 1.5;
}

// ===== 写日记 FAB =====
.pdiary-fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  z-index: 50;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, $color-primary-light, $color-primary);
  box-shadow: $shadow-button;
  @include flex-center;

  &:active {
    transform: scale(0.92);
  }
}

.pdiary-fab__icon {
  font-size: 48rpx;
  line-height: 1;
}
