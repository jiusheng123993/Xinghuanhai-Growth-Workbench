@import '../../styles/_theme';
@import '../../styles/_animations';

// ============================================
// 时光线页 — 温馨暖色时间线 + 固定功能卡片 + 丰富动效
// ============================================

.timeline-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  /* 背景统一由 <PageBackground /> 组件渲染（含星空/格纹/照片壁纸），此处保持透明 */
  background: transparent;
  animation: pageEnter 0.4s ease-out;
}

// ===== 固定顶部区域 =====
.timeline-fixed-top {
  flex-shrink: 0;
  background: $gradient-page;
  padding-bottom: 16rpx;
  z-index: 10;
}

// ===== 头部 =====
.timeline-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 56rpx 40rpx 16rpx;
}

.timeline-header-left {
  min-width: 0;
}

.timeline-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
  color: $color-text-primary;
}

.timeline-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: $color-text-tertiary;
}

.timeline-add-round-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, $color-primary-light, $color-primary);
  box-shadow: $shadow-button;
  transition: transform 0.15s ease;

  &:active {
    transform: scale(0.9);
  }
}

.timeline-add-round-icon {
  font-size: 48rpx;
  color: $color-text-inverse;
  font-weight: 400;
  line-height: 1;
}

// ===== 回忆精选（横向滚动，原型对齐） =====
.timeline-featured {
  margin-top: 24rpx;
}

.timeline-featured-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  margin-bottom: 24rpx;
}

.timeline-featured-title {
  font-size: 36rpx;
  font-weight: 700;
  color: $color-text-primary;
}

.timeline-featured-hint {
  font-size: 24rpx;
  color: $color-text-tertiary;
}

.timeline-featured-scroll {
  white-space: nowrap;
  padding: 0 40rpx;
}

.timeline-featured-card {
  display: inline-flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  width: 512rpx;
  height: 320rpx;
  border-radius: 48rpx;
  padding: 40rpx;
  margin-right: 24rpx;
  transition: transform 0.2s ease;

  &:active {
    transform: scale(0.98);
  }

  &--coral {
    background: linear-gradient(135deg, $color-primary-light, $color-primary);
    box-shadow: $shadow-sm;
  }

  &--gold {
    background: linear-gradient(135deg, $color-gold-soft, $color-gold);
    box-shadow: $shadow-sm;
  }

  &--sage {
    background: linear-gradient(135deg, #8AD390, #54B460);
    box-shadow: $shadow-sm;
  }
}

.timeline-featured-card-glow {
  position: absolute;
  right: -56rpx;
  top: -72rpx;
  width: 224rpx;
  height: 224rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  pointer-events: none;
}

.timeline-featured-card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.timeline-featured-card-text {
  margin-top: auto;
}

.timeline-featured-card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.3;
}

.timeline-featured-card-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

// ===== 加载中状态（回忆精选卡片复用） =====
.timeline-func-card--loading {
  opacity: 0.7;
  pointer-events: none;
}

// ===== 添加时光记录主按钮（原型对齐：全宽圆角渐变） =====
.timeline-add-main-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 112rpx;
  border-radius: 999rpx;
  margin: 48rpx 40rpx 0;
  background: linear-gradient(135deg, $color-primary-light, $color-primary);
  box-shadow: $shadow-button;
  transition: transform 0.15s ease, opacity 0.15s ease;

  &:active {
    transform: scale(0.98);
    opacity: 0.92;
  }
}

.timeline-add-main-icon {
  font-size: 40rpx;
  color: $color-text-inverse;
  font-weight: 400;
  line-height: 1;
}

.timeline-add-main-text {
  font-size: 30rpx;
  font-weight: $font-weight-semibold;
  color: $color-text-inverse;
}

// ===== 可滚动区域 =====
.timeline-scroll {
  flex: 1;
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
}

// ===== 横幅 =====
.timeline-banner {
  margin: 0 32rpx 28rpx;
}

.timeline-banner-inner {
  position: relative;
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-radius: $radius-lg;
  background: $gradient-card;
  border: 1rpx solid $color-border;
  overflow: hidden;
  @include breathe-glow;
}

.timeline-banner-glow {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(ellipse at center, rgba($color-primary, 0.08), transparent 70%);
  pointer-events: none;
}

.timeline-banner-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  position: relative;
  z-index: 1;
}

.timeline-banner-icon {
  font-size: 44rpx;
  animation: pulse 2.5s ease-in-out infinite;
}

.timeline-banner-text-wrap {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.timeline-banner-title {
  font-size: 28rpx;
  font-weight: 600;
  color: $color-text-primary;
}

.timeline-banner-desc {
  font-size: 24rpx;
  color: $color-text-secondary;
}

.timeline-banner-close {
  position: relative;
  z-index: 1;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: $color-text-tertiary;
  border-radius: 50%;
  transition: all 0.2s ease;

  &:active {
    background: $color-primary-bg;
  }
}

// ===== 时间线列表 =====
.timeline-list {
  padding: 0 32rpx;
}

.timeline-list-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: $color-text-primary;
  margin-bottom: 32rpx;
}

.timeline-item {
  display: flex;
  gap: 20rpx;
}

// ===== 时间线左边 =====
.timeline-line-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 52rpx;
  flex-shrink: 0;
}

.timeline-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: $radius-full;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  border: 2rpx solid $color-bg-page;

  &--milestone {
    background: $gradient-gold;
    box-shadow: 0 0 20rpx rgba($color-primary, 0.5);
    animation: rootGlow 2.5s ease-in-out infinite;
  }

  &--memory {
    background: linear-gradient(135deg, $color-coral, $color-primary-dark);
    box-shadow: 0 0 14rpx rgba($color-coral, 0.4);
  }

  &--flashback {
    background: linear-gradient(135deg, $color-teal, $color-primary-dark);
    box-shadow: 0 0 14rpx rgba($color-teal, 0.4);
  }

  &--ghost {
    background: rgba($color-text-hint, 0.4);
    box-shadow: none;
  }
}

.timeline-dot-emoji {
  font-size: 24rpx;
  line-height: 1;
}

.timeline-line {
  width: 3rpx;
  flex: 1;
  min-height: 40rpx;
  background: linear-gradient(180deg, $color-primary 0%, rgba($color-primary, 0.1) 100%);
  opacity: 0.5;
}

// ===== 时间线卡片 =====
.timeline-card {
  flex: 1;
  margin-bottom: 32rpx;
  padding: 24rpx;
  border-radius: $radius-md;
  background: $color-bg-card;
  border: 1px solid $color-border;
  transition: all 0.2s cubic-bezier(0.22, 0.61, 0.36, 1);

  &:active {
    transform: scale(0.98);
    opacity: 0.9;
  }

  &--ghost {
    opacity: 0.55;
    border-style: dashed;
    border-color: rgba($color-text-hint, 0.3);
  }

  &--flashback {
    border-color: rgba($color-teal, 0.4);
    background: linear-gradient(135deg, rgba($color-teal, 0.08), $color-bg-card);
  }
}

// ===== 卡片动画 =====
.timeline-item:nth-child(1) .timeline-card { animation: cardStaggerIn 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) both; animation-delay: 0s; }
.timeline-item:nth-child(2) .timeline-card { animation: cardStaggerIn 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) both; animation-delay: 0.06s; }
.timeline-item:nth-child(3) .timeline-card { animation: cardStaggerIn 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) both; animation-delay: 0.12s; }
.timeline-item:nth-child(4) .timeline-card { animation: cardStaggerIn 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) both; animation-delay: 0.18s; }
.timeline-item:nth-child(5) .timeline-card { animation: cardStaggerIn 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) both; animation-delay: 0.24s; }
.timeline-item:nth-child(6) .timeline-card { animation: cardStaggerIn 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) both; animation-delay: 0.3s; }

.timeline-card-date {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.timeline-date-text {
  font-size: 24rpx;
  color: $color-text-secondary;
}

.timeline-milestone-badge {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: $color-primary-bg;
  border: 1px solid $color-border;
}

.timeline-milestone-badge-text {
  font-size: 20rpx;
  color: $color-primary;
  font-weight: 600;
}

.timeline-flashback-badge {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba($color-teal, 0.14);
  border: 1px solid rgba($color-teal, 0.35);
}

.timeline-flashback-badge-text {
  font-size: 20rpx;
  color: $color-teal;
  font-weight: 600;
}

// ===== 回忆标签（原型对齐：success 色） =====
.timeline-memory-badge {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba($color-success, 0.14);
  border: 1px solid rgba($color-success, 0.35);
}

.timeline-memory-badge-text {
  font-size: 20rpx;
  color: $color-success;
  font-weight: 600;
}

.timeline-ghost-badge {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba($color-text-hint, 0.15);
  border: 1px solid rgba($color-text-hint, 0.3);
}

.timeline-ghost-badge-text {
  font-size: 20rpx;
  color: $color-text-tertiary;
}

.timeline-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: $color-text-primary;
  margin-bottom: 8rpx;
  display: block;
}

.timeline-card-desc {
  font-size: 24rpx;
  color: $color-text-secondary;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}

.timeline-photo-grid {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

// 时间线卡片内真实照片（原实现只有占位符，现在直接展示图片）
.timeline-photo-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: $color-bg-secondary;
  border: 1rpx solid $color-border-light;
}

.timeline-photo-empty {
  margin-top: 4rpx;
}

.timeline-photo-dashed {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: $color-bg-secondary;
  border: 1rpx solid $color-border-light;
  transition: all 0.2s ease;
  @include press-feedback;

  &:active {
    border-color: $color-primary;
    background: $color-primary-bg;
  }
}

.timeline-photo-add-icon {
  font-size: 32rpx;
  color: $color-text-tertiary;
}

.timeline-photo-add-text {
  font-size: 22rpx;
  color: $color-text-tertiary;
}

.timeline-bottom-safe {
  height: 60rpx;
}

// ===== 年度回忆模态 =====
.timeline-review-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.25s ease-out;
}

.timeline-review-modal {
  width: 92%;
  max-width: 680rpx;
  max-height: 90vh;
  border-radius: $radius-xl;
  background: $color-bg-card;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: modalSlideUp 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.timeline-review-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1px solid $color-border;
}

.timeline-review-header-title {
  font-size: 28rpx;
  font-weight: 600;
  color: $color-text-primary;
}

.timeline-review-header-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: $radius-full;
  background: $color-bg-secondary;
  @include flex-center;
  font-size: 24rpx;
  color: $color-text-tertiary;

  &:active {
    background: $color-primary-bg;
  }
}

.timeline-review-image-wrap {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx;
}

.timeline-review-image {
  width: 100%;
  padding-top: 177.8%;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
  border-radius: $radius-md;
}

.timeline-review-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx 28rpx;
  border-top: 1px solid $color-border;
}

.timeline-review-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: $radius-full;
  text-align: center;
  transition: all 0.2s ease;
  @include press-feedback;

  &--primary {
    background: $gradient-gold;
  }

  &--outline {
    border: 2rpx solid $color-border;
  }
}

.timeline-review-btn-text {
  font-size: 26rpx;
  font-weight: 600;

  .timeline-review-btn--primary & {
    color: $color-text-inverse;
  }
  .timeline-review-btn--outline & {
    color: $color-text-secondary;
  }
}

.timeline-review-canvas {
  pointer-events: none;
  opacity: 0;
}

@keyframes modalSlideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

// ===== 新增回忆弹窗 =====
.timeline-add-memory-body {
  padding: 0 32rpx 24rpx;
}

.timeline-add-memory-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  border-radius: $radius-md;
  background: $color-bg-secondary;
  font-size: 28rpx;
  color: $color-text-primary;
  border: 1rpx solid $color-border-light;
  box-sizing: border-box;
}

.timeline-add-memory-photo-icon {
  font-size: 36rpx;
}

.timeline-add-memory-photo-label {
  font-size: 26rpx;
  color: $color-text-secondary;
}

.timeline-add-memory-photo-img {
  width: 100%;
  height: 100%;
}

.timeline-add-memory-photo-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: $radius-full;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
}

.timeline-review-btn--disabled {
  opacity: 0.5;
  pointer-events: none;
}

// ===== 新增回忆弹窗（升级版：日期补记 + 多图 + AI 辅助） =====
.timeline-add-memory-modal {
  width: 92%;
  max-width: 680rpx;
  max-height: 88vh;
  border-radius: $radius-xl;
  background: $color-bg-card;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: modalSlideUp 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}

// 回忆日期选择行
.timeline-add-memory-date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: $radius-md;
  background: $color-bg-secondary;
  border: 1rpx solid $color-border-light;
}

.timeline-add-memory-date-label {
  font-size: 26rpx;
  color: $color-text-secondary;
}

.timeline-add-memory-date-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: $color-primary;
}

.timeline-add-memory-date-arrow {
  font-size: 20rpx;
  opacity: 0.6;
}

// AI 辅助按钮行
.timeline-add-memory-ai-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.timeline-ai-btn {
  flex: 1;
  padding: 16rpx 0;
  border-radius: $radius-full;
  text-align: center;
  background: linear-gradient(135deg, rgba($color-primary, 0.12), rgba($color-coral, 0.12));
  border: 1rpx solid rgba($color-primary, 0.35);
  transition: all 0.2s ease;
  @include press-feedback;

  &:active {
    background: linear-gradient(135deg, rgba($color-primary, 0.22), rgba($color-coral, 0.22));
  }

  &--disabled {
    opacity: 0.45;
    pointer-events: none;
  }
}

.timeline-ai-btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: $color-primary;
}

// 多图九宫格
.timeline-add-memory-photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.timeline-add-memory-photo-item {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  border-radius: $radius-md;
  overflow: hidden;
  border: 1rpx solid $color-border-light;
}

.timeline-add-memory-photo-add {
  width: 150rpx;
  height: 150rpx;
  border-radius: $radius-md;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: $color-bg-secondary;
  border: 2rpx dashed $color-border;
  transition: all 0.2s ease;
  @include press-feedback;

  &:active {
    border-color: $color-primary;
    background: $color-primary-bg;
  }
}

.timeline-add-memory-photo-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: $color-text-tertiary;
}

// ===== 回忆详情弹窗（大图 + 完整文案 + 删除） =====
.timeline-detail-modal {
  width: 92%;
  max-width: 680rpx;
  max-height: 88vh;
  border-radius: $radius-xl;
  background: $color-bg-card;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: modalSlideUp 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.timeline-detail-body {
  padding: 20rpx 28rpx 8rpx;
  overflow-y: auto;
}

.timeline-detail-date {
  display: block;
  font-size: 24rpx;
  color: $color-text-secondary;
  margin-bottom: 16rpx;
}

// 详情大图横滑
.timeline-detail-photos {
  width: 100%;
  margin-bottom: 16rpx;
}

.timeline-detail-photos-row {
  display: flex;
  gap: 12rpx;
}

.timeline-detail-photo {
  width: 320rpx;
  height: 320rpx;
  border-radius: $radius-md;
  flex-shrink: 0;
  background: $color-bg-secondary;
}

.timeline-detail-desc {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: $color-text-primary;
  padding-bottom: 20rpx;
}

// 危险操作按钮（删除回忆）
.timeline-review-btn--danger {
  background: linear-gradient(135deg, #FF7875, #FF4D4F);
  flex: 1;

  .timeline-review-btn-text {
    color: #fff;
  }
}

// ===== 空状态 =====
.timeline-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  text-align: center;

  &__icon {
    font-size: 80rpx;
    margin-bottom: 24rpx;
  }

  &__title {
    display: block;
    font-size: 32rpx;
    font-weight: 600;
    color: $color-text-primary;
    margin-bottom: 16rpx;
  }

  &__desc {
    display: block;
    font-size: 26rpx;
    color: $color-text-secondary;
    line-height: 1.6;
  }
}
